# Copy to .env and adjust. Only SECRET_KEY is required in production.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Development runs on SQLite with an in-memory channel layer by default.
# Set these to True to use Postgres and Redis locally instead.
USE_POSTGRES=False
USE_REDIS=False

POSTGRES_DB=monograph
POSTGRES_USER=monograph
POSTGRES_PASSWORD=monograph
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

REDIS_URL=redis://localhost:6379/0

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

MAX_UPLOAD_SIZE_MB=50
LOG_LEVEL=INFO
