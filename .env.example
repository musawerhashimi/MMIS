# Copy to .env before starting. Only the marked values must be changed.

# --- Required --------------------------------------------------------------
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-long-random-string
POSTGRES_PASSWORD=change-me-to-a-strong-password

# The addresses people will use to reach the system. Include the server's
# hostname and its address on the university network.
ALLOWED_HOSTS=localhost,127.0.0.1,monograph.university.edu
CSRF_TRUSTED_ORIGINS=http://localhost,http://monograph.university.edu

# --- Institution -----------------------------------------------------------
# Printed on the letterhead of every official form.
UNIVERSITY_NAME=Kabul University

# --- Serving ---------------------------------------------------------------
HTTP_PORT=80
DEBUG=False

# Set to False when the system is served over plain HTTP inside the campus
# network. Leave True if a certificate is installed in front of it.
SECURE_SSL_REDIRECT=False

# --- Database --------------------------------------------------------------
POSTGRES_DB=monograph
POSTGRES_USER=monograph

# --- Sessions --------------------------------------------------------------
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# --- Uploads ---------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=50

# --- Backups ---------------------------------------------------------------
# Taken nightly. Copy them off this machine regularly — a backup that lives
# only on the disk it is protecting is not a backup.
BACKUP_KEEP_DAYS=30

LOG_LEVEL=INFO
