# The API, the websocket server, and the background workers all run from
# this image — they differ only in the command they are given.
FROM python:3.12-slim AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

# WeasyPrint renders the official forms and needs real font and graphics
# libraries; without these the PDFs come out blank or fail outright.
RUN apt-get update && apt-get install --no-install-recommends -y \
        build-essential \
        libpq-dev \
        libpango-1.0-0 \
        libpangoft2-1.0-0 \
        libharfbuzz0b \
        libffi-dev \
        libjpeg62-turbo \
        fonts-dejavu-core \
        postgresql-client \
        curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/ .

# Uploaded student work and nightly backups live on mounted volumes, so they
# survive the container being rebuilt.
RUN mkdir -p /app/media /app/private_media /app/staticfiles /app/backups

# Never run as root: a flaw in the application should not mean a flaw in the
# host it is installed on.
RUN useradd --create-home --shell /bin/bash app \
    && chown -R app:app /app
USER app

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
    CMD curl -fsS http://localhost:8000/api/health/ || exit 1

# Daphne rather than gunicorn: the same process serves HTTP and the
# websockets that keep dashboards live.
CMD ["daphne", "-b", "0.0.0.0", "-p", "8000", "config.asgi:application"]
